+		CERROR("2c: can't init llog handle: %d\n", rc);
+		GOTO(out_close, rc);
+	}
+
+	/* on-disk values after llog re-open */
+	rc = verify_handle("2c", lgh, 1);
+	if (rc < 0)
+		GOTO(out_close, rc);
+
+	CWARN("2d: destroy this log\n");
+	rc = llog_destroy(env, lgh);
+	if (rc)
+		CERROR("2d: destroy log failed\n");
+out_close:
+	llog_close(env, lgh);
+out_close_llh:
