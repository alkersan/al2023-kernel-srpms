+	.o_fid_fini	    = client_fid_fini,
+	.o_fid_alloc	    = mdc_fid_alloc,
+	.o_import_event     = mdc_import_event,
+	.o_get_info	    = mdc_get_info,
+	.o_get_uuid	    = mdc_get_uuid,
+	.o_quotactl	    = mdc_quotactl,
+};
