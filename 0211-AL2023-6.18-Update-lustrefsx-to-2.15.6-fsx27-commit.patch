+static const struct lnet_lnd *lnet_find_lnd_by_type(__u32 type)
+{
+	const struct lnet_lnd *lnd;
+
+	/* holding lnd mutex */
+	if (type >= NUM_LNDS)
+		return NULL;
+	lnd = the_lnet.ln_lnds[type];
+	LASSERT(!lnd || lnd->lnd_type == type);
+
+	return lnd;
+}
