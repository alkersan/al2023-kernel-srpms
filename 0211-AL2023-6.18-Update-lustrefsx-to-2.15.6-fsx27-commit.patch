+		if (obd)
+			CERROR("%s: not attached\n", obd->obd_name);
+		return -ENODEV;
+	}
+
+	spin_lock(&obd->obd_dev_lock);
+	obd->obd_no_transno = 1;
+	spin_unlock(&obd->obd_dev_lock);
