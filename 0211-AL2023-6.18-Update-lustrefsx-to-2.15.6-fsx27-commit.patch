+	rc = verify_handle("2c", lgh, 2);
+	if (rc < 0)
+		GOTO(out_close, rc);
+
+	rc = llog_process(env, lgh, test_2_cancel_cb, NULL, NULL);
+	if (rc < 0)
+		GOTO(out_close, rc);
+
+	/* in-memory values */
+	rc = verify_handle("2c", lgh, 1);
+	if (rc < 0)
+		GOTO(out_close, rc);
+
+	/* re-open llog to get on-disk values */
