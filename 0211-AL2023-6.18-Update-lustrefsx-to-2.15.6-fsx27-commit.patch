+#include <rdma/ib_verbs.h>
+
+#ifndef HAVE_IBDEV_TO_NODE
+/**
+ * ibdev_to_node - return the NUMA node for a given ib_device
+ * @dev:	device to get the NUMA node for.
+ */
+static inline int ibdev_to_node(struct ib_device *ibdev)
+{
+	struct device *parent = ibdev->dev.parent;
+
+	if (!parent)
+		return NUMA_NO_NODE;
+	return dev_to_node(parent);
+}
+#endif
diff --git a/net/lnet/lnet/klnds/o2iblnd/Makefile b/net/lnet/lnet/klnds/o2iblnd/Makefile
new file mode 100644
--- /dev/null
+++ b/net/lnet/lnet/klnds/o2iblnd/Makefile
@@ -0,0 +1,5 @@
+obj-$(CONFIG_LUSTRE_LNET_XPRT_IB)	+= ko2iblnd.o
+
+ko2iblnd-y		:= o2iblnd.o o2iblnd_cb.o o2iblnd_modparams.o
+
+include $(srctree)/net/lnet/Makefile.rules
