+	__u32 gh_seq;         /* sequence */
+	__u32 gh_svc;         /* service */
+	__u32 gh_pad1;
+	__u32 gh_pad2;
+	__u32 gh_pad3;
+	netobj_t gh_handle;      /* context handle */
+};
