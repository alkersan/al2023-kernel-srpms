+ */
+#ifndef _LUSTRE_COMPAT_LINUX_FOLIO_H
+#define _LUSTRE_COMPAT_LINUX_FOLIO_H
+
+#include <linux/aio.h>
+#include <linux/fs.h>
+#include <linux/namei.h>
+#include <linux/pagemap.h>
+#include <linux/posix_acl_xattr.h>
