+static inline struct lnet_rsp_tracker *
+lnet_rspt_alloc(int cpt)
+{
+	struct lnet_rsp_tracker *rspt;
+
+	rspt = kmem_cache_zalloc(lnet_rspt_cachep, GFP_NOFS);
+	if (rspt) {
