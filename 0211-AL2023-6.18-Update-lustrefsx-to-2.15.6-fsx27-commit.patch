+{
+	struct obd_device *obd = data;
+	struct client_obd *cli = &obd->u.cli;
+
+	spin_lock(&cli->cl_loi_list_lock);
+	seq_printf(m, "%d\n", cli->cl_max_pages_per_rpc);
+	spin_unlock(&cli->cl_loi_list_lock);
