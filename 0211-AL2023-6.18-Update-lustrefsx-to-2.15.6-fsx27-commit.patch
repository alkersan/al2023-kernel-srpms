+static int
+libcfs_num_addr_range_print(char *buffer, int count, struct list_head *list)
+{
+	struct cfs_expr_list *el;
+	int i = 0, j = 0;
+
+	list_for_each_entry(el, list, el_link) {
+		assert(j++ < 1);
+		i += cfs_expr_list_print(buffer + i, count - i, el);
+	}
+	return i;
+}
