+#define EFALND_MAX_TX_FRAGS		(LNET_MAX_IOV + 1)
+
+/* Max # of TXs each NI can allocate. */
+#define EFALND_MAX_NI_TX_POOL		2048
+
+/* default values in case no tunable was set */
