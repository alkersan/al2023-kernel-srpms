+void lprocfs_fini_brw_stats(struct brw_stats *brw_stats)
+{
+	int i;
+
+	for (i = 0; i < BRW_RW_STATS_NUM; i++)
+		lprocfs_oh_release_pcpu(&brw_stats->bs_hist[i]);
