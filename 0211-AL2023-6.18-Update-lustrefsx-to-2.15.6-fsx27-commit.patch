+unsigned long lprocfs_oh_sum_pcpu(struct obd_hist_pcpu *oh)
+{
+	unsigned long ret = 0;
+	int i;
+
+	for (i = 0; i < OBD_HIST_MAX; i++)
+		ret += percpu_counter_sum(&oh->oh_pc_buckets[i]);
