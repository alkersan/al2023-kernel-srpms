+
+struct lookup_intent {
+	int			 it_op;
+	int			 it_create_mode;
+	__u64			 it_flags;
+	int			 it_disposition;
+	int			 it_status;
+	__u64			 it_lock_handle;
+	__u64			 it_lock_bits;
+	int			 it_lock_mode;
