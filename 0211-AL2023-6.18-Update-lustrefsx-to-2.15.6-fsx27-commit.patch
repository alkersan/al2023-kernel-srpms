+/* Extracts the second-to-last ciphertext block; see explanation below */
+#define LLCRYPT_FNAME_DIGEST(name, len)	\
+	((name) + round_down((len) - LL_CRYPTO_BLOCK_SIZE - 1, \
+			     LL_CRYPTO_BLOCK_SIZE))
