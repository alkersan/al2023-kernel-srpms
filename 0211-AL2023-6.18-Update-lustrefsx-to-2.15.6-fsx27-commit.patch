--- /dev/null
+++ b/net/lnet/libcfs/libcfs/linux-crypto.c
@@ -0,0 +1,487 @@
+/* GPL HEADER START
+ *
+ * DO NOT ALTER OR REMOVE COPYRIGHT NOTICES OR THIS FILE HEADER.
