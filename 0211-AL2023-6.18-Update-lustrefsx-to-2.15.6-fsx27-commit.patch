+/*
+ * Request formats.
+ */
+
+struct req_format {
+	const char *rf_name;
+	size_t	    rf_idx;
+	struct {
+		size_t			     nr;
+		const struct req_msg_field **d;
+	} rf_fields[RCL_NR];
+};
+
+#define DEFINE_REQ_FMT(name, client, client_nr, server, server_nr) {    \
+        .rf_name   = name,                                              \
+        .rf_fields = {                                                  \
+                [RCL_CLIENT] = {                                        \
+                        .nr = client_nr,                                \
+                        .d  = client                                    \
+                },                                                      \
+                [RCL_SERVER] = {                                        \
+                        .nr = server_nr,                                \
+                        .d  = server                                    \
+                }                                                       \
+        }                                                               \
+}
+
+#define DEFINE_REQ_FMT0(name, client, server)                                  \
+DEFINE_REQ_FMT(name, client, ARRAY_SIZE(client), server, ARRAY_SIZE(server))
+
