+static inline int
+ksocknal_conn_cb_mask(void)
+{
+	if (!*ksocknal_tunables.ksnd_typed_conns)
+		return BIT(SOCKLND_CONN_ANY);
+
+	return (BIT(SOCKLND_CONN_CONTROL) |
+		BIT(SOCKLND_CONN_BULK_IN) |
+		BIT(SOCKLND_CONN_BULK_OUT));
+}
