+};
+
+/* For LE_PAIRS_VERIFY returned status */
+enum lfsck_pv_status {
+	LPVS_INIT		= 0,
+	LPVS_INCONSISTENT	= 1,
+	LPVS_INCONSISTENT_TOFIX = 2,
+};
+
+enum lfsck_events_local {
+	LEL_FID_ACCESSED	= 1,
+	LEL_PAIRS_VERIFY_LOCAL	= 2,
+};
+
+struct lfsck_req_local {
+	__u32		lrl_event;
+	__u32		lrl_status;
+	__u16		lrl_active;
+	__u16		lrl_padding0;
+	__u32		lrl_padding1;
