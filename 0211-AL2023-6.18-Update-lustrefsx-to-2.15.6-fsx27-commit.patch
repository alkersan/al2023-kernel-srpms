+	if (valid & LA_GID) {
+		dst->o_gid = la->la_gid;
+		newvalid |= OBD_MD_FLGID;
+	}
+	if (valid & LA_PROJID) {
+		dst->o_projid = la->la_projid;
+		newvalid |= OBD_MD_FLPROJID;
+	}
+	if (valid & LA_FLAGS) {
+		dst->o_flags = la->la_flags;
+		newvalid |= OBD_MD_FLFLAGS;
+	}
+	if (valid & LA_NLINK) {
