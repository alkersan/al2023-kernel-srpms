diff --git a/fs/lustre/lmv/lmv_fld.c b/fs/lustre/lmv/lmv_fld.c
new file mode 100644
--- /dev/null
+++ b/fs/lustre/lmv/lmv_fld.c
@@ -0,0 +1,87 @@
+/*
