+static struct nrs_tbf_client *
+nrs_tbf_nid_cli_findadd(struct nrs_tbf_head *head,
+			struct nrs_tbf_client *cli)
+{
+	return cfs_hash_findadd_unique(head->th_cli_hash, &cli->tc_nid,
+				       &cli->tc_hnode);
+}
