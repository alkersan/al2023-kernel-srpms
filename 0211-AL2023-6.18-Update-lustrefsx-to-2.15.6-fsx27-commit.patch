+static int lmv_get_root(struct obd_export *exp, const char *fileset,
+			struct lu_fid *fid)
+{
+	struct obd_device *obd = exp->exp_obd;
+	struct lmv_obd *lmv = &obd->u.lmv;
+	struct lu_tgt_desc *tgt = lmv_tgt(lmv, 0);
+	int rc;
