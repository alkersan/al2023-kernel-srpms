+	if (rc)
+		return rc;
+
+	gss_check_upcall_ns = val;
+	return count;
+}
+LPROC_SEQ_FOPS(sptlrpc_gss_check_upcall_ns);
+#endif /* HAVE_GSS_KEYRING */
