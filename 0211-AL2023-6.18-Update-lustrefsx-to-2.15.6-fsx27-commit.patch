+static inline s64 osc_submit_duration(struct osc_page *opg)
+{
+	if (ktime_to_ns(opg->ops_submit_time) == 0)
+		return 0;
+
+	return ktime_ms_delta(ktime_get(), opg->ops_submit_time);
+}
