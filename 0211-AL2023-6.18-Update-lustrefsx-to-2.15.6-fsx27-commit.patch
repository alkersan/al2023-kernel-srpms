+	case LLT_RELEASED:
+		return "RELEASED";
+	case LLT_COMP:
+		return "COMPOSITE";
+	case LLT_FOREIGN:
+		return "FOREIGN";
+	case LLT_NR:
+		LBUG();
+	}
+	LBUG();
+	return "";
+}
