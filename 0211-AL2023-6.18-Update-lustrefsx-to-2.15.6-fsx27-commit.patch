+static struct nrs_tbf_client *
+nrs_tbf_nid_cli_find(struct nrs_tbf_head *head,
+		     struct ptlrpc_request *req)
+{
+	return cfs_hash_lookup(head->th_cli_hash, &req->rq_peer.nid);
+}
