+static inline void
+swi_init_workitem(struct swi_workitem *swi,
+		  swi_action_t action, struct workqueue_struct *wq)
+{
+	swi->swi_wq = wq;
+	swi->swi_action = action;
+	swi->swi_state  = SWI_STATE_NEWBORN;
+	INIT_WORK(&swi->swi_work, swi_wi_action);
+}
