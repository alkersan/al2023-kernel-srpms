+	const struct mdt_body	*tsi_mdt_body;
+	struct ost_body		*tsi_ost_body;
+	struct lu_object	*tsi_corpus;
+
+	struct lu_fid		 tsi_fid;
+	struct ldlm_res_id	 tsi_resid;
