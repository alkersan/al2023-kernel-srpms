+lnet_ni_set_status(struct lnet_ni *ni, __u32 status)
+{
+	bool update;
+
+	lnet_ni_lock(ni);
+	update = lnet_ni_set_status_locked(ni, status);
+	lnet_ni_unlock(ni);
+
+	return update;
+}
