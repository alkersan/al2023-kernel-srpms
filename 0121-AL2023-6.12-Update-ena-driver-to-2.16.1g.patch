+static void check_for_lost_interrupts(struct ena_adapter *adapter)
+{
+	struct ena_ring *tx_ring, *rx_ring;
+	unsigned long last_napi_jiffies;
+	struct ena_napi *ena_napi;
+	bool lost_interrupt;
+	int i;
