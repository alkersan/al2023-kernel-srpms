+	for (i = 0; i < adapter->num_io_queues + adapter->xdp_num_queues; i++) {
+		lost_interrupt = false;
+		tx_ring = &adapter->tx_ring[i];
+		ena_napi = container_of(tx_ring->napi, struct ena_napi, napi);
+
