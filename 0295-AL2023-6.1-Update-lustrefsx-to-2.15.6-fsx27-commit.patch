+static inline void folio_bounce_private(struct folio *src, s16 srcpg,
+					struct folio *dst, s16 dstpg)
+{
+	s16 spg __maybe_unused = srcpg > 0 ? srcpg : 0;
+	s16 dpg __maybe_unused = dstpg > 0 ? srcpg : 0;
+
+	if (spg) {
+		struct page *vmpg;
