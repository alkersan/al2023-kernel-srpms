+#ifndef DRV_MODULE_VERSION
+#define DRV_MODULE_VERSION \
+	__stringify(DRV_MODULE_VER_MAJOR) "."   \
+	__stringify(DRV_MODULE_VER_MINOR) "."   \
+	__stringify(DRV_MODULE_VER_SUBMINOR) "a"
