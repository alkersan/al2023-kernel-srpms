diff --git a/drivers/amazon/scsi/mpi3mr/Kconfig b/drivers/amazon/scsi/mpi3mr/Kconfig
new file mode 100644
--- /dev/null
+++ b/drivers/amazon/scsi/mpi3mr/Kconfig
@@ -0,0 +1,9 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+config AMAZON_SCSI_MPI3MR
+	tristate "Broadcom MPI3 Storage Controller Device Driver"
+	depends on PCI && SCSI
+	select BLK_DEV_BSGLIB
+	select SCSI_SAS_ATTRS
+	help
+	MPI3 based Storage & RAID Controllers Driver.
\ No newline at end of file
diff --git a/drivers/amazon/scsi/mpi3mr/Makefile b/drivers/amazon/scsi/mpi3mr/Makefile
new file mode 100644
--- /dev/null
+++ b/drivers/amazon/scsi/mpi3mr/Makefile
@@ -0,0 +1,9 @@
+# mpi3mr makefile
+obj-$(CONFIG_AMAZON_SCSI_MPI3MR) += mpi3mr.o
+mpi3mr-y +=  mpi3mr_os.o     \
+		mpi3mr_fw.o \
+		mpi3mr_app.o \
+		mpi3mr_debugfs.o \
+		mpi3mr_transport.o 
+
+
