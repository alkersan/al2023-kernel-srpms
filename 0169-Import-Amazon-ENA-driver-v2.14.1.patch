+	target_cdesc_idx = io_cq->head & (io_cq->q_depth - 1);
+	cdesc = ena_com_tx_cdesc_idx_to_ptr(io_cq, target_cdesc_idx);
+	ena_com_dump_single_tx_cdesc(io_cq, cdesc);
+}
