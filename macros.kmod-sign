# vim:filetype=spec

# Amazon Linux uses a different signing mechanism and test certificate
# for secure boot. It relies on those two macros being set by the caller:
#
#  %amzn_sb_keyname   : Base name (sign-grub, sign-kernel, sign-modules)
#  %amzn_sb_keyver    : Version (a number)
#
%amzn_sb_keyname @invalid-key
%amzn_sb_keyver  @invalid-key
%__amzn_sb_key_fullname %{?amzn_sb_keyname}-%{amzn_sb_keyver}

# For module signing the caller must also define the target kernel package
# version-releases %%amzn_sb_kverrel so that the correct kernel-devel tools are
# used.
%amzn_sb_kverrel @invalid-version

%kmod_sb_signing_cert_path /tmp/%{__amzn_sb_key_fullname}.pem
%kmod_sb_sign_file /usr/src/kernels/%{amzn_sb_kverrel}/scripts/sign-file
%kmod_sb_p11_socket /tmp/amzn-sb-keys/p11-kit-kms.socket

# Both of these variants take a path to the target livepatch module as an
# argument.
%kmod_sb_sign_module_signfile				\\\
	%{kmod_sb_sign_file} -c sha256			\\\
	pkcs11:token=%{__amzn_sb_key_fullname}		\\\
	%{kmod_sb_signing_cert_path}			\\\
	%{1}

%kmod_sb_sign_module_openssl				\\\
	openssl smime -engine pkcs11 -keyform engine	\\\
	-sign -noattr -binary				\\\
	-in %{1}					\\\
	-inkey "pkcs11:token=%{__amzn_sb_key_fullname}"	\\\
	-signer %{kmod_sb_signing_cert_path}		\\\
	-outform DER					\\\
	-out foo.sign					\
	%{kmod_sb_sign_file}				\\\
	-s foo.sign sha256 %{kmod_sb_signing_cert_path}	\\\
	%{1}						\
	rm foo.sign

# We have two working methods to sign (livepatch) modules; via a patched
# sign_file which includes the proper signature and public key, or via openssl
# to extract the full signature before passing to sign_file.  The former is
# preferred, but keep both approaches here depending on what goes upstream.
# %%fallback_sign_method 1
%__kmod_sb_fallback_sign_method %{?kmod_sb_fallback_sign_method:%{kmod_sb_fallback_sign_method}}%{!?kmod_sb_fallback_sign_method:0}

%kmod_sb_sign_module() (if [ %{__kmod_sb_fallback_sign_method} -eq 0 ]; then \
%{expand: %{kmod_sb_sign_module_signfile}} ;\
else \
%{expand: %{kmod_sb_sign_module_openssl}} ;\
fi)

# Determine if the current build is happening on a secure builder
%kmod_sb_in_secure_builder [ "${USER}" = "mockbuild" ] && [ -d /tmp/amzn-sb-keys ]

# This must be invoked prior to calling %%kmod_sb_sign_file <livepatch>
# This intentionally exits if the socket is not available; callers should check
# whether they expect signing to be available with %%kmod_sb_in_secure_builder.
%kmod_sb_setup_keys										\
	if ! [[ -S "%{kmod_sb_p11_socket}" ]] ; then						\
		echo "Error: pkcs11 socket socket missing on secure builder"			\
		exit 1										\
	fi											\
	export P11_KIT_SERVER_ADDRESS="unix:path=%{kmod_sb_p11_socket}"				\
	mkdir -p ${HOME}/.config/pkcs11/modules							\
	echo "module: p11-kit-client.so" > ~/.config/pkcs11/modules/p11-kit-client.module	\
	p11tool --export "pkcs11:object=%{__amzn_sb_key_fullname};type=cert" > %{kmod_sb_signing_cert_path}
